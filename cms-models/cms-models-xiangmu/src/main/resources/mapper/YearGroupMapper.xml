<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xk.mapper.YearGroupMapper">

    <!-- ResultMap 对象用于映射查询结果 -->
    <resultMap id="YearGroupResultMap" type="com.xk.domain.vo.group.YearDetailedLisVo">
        <id property="yearGroupId" column="yearGroupId"/>
        <result property="name" column="name"/>
        <result property="status" column="status"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="createBy"/>
        <result property="createTime" column="createTime"/>
        <result property="updateBy" column="updateBy"/>
        <collection property="yearDataList" ofType="com.xk.domain.vo.group.YearDataVo">
            <id property="yearDataId" column="yearDataId"/>
            <result property="name" column="yearDataName"/>
            <result property="begin" column="begin"/>
            <result property="end" column="end"/>
        </collection>
    </resultMap>

    <select id="selectWithDynamicQuery" resultMap="YearGroupResultMap">
        SELECT
        g.year_group_id AS yearGroupId,
        g.name AS name,
        g.status AS status,
        g.remark AS remark,
        g.create_by AS createBy,
        g.create_time AS createTime,
        g.update_by AS updateBy,
        d.year_data_id AS yearDataId,
        d.name AS yearDataName,
        d.begin AS begin,
        d.end AS end
        FROM
        xm_year_group g
        JOIN
        xm_year_data d
        ON
        g.year_group_id = d.year_group_id
        <where>
            <if test="yearGroupName != null and yearGroupName != ''">
                g.name LIKE CONCAT('%', #{yearGroupName}, '%')
            </if>
            <if test="yearDataName != null and yearDataName != ''">
                <if test="yearGroupName == null or yearGroupName == ''">
                    AND d.name LIKE CONCAT('%', #{yearDataName}, '%')
                </if>
                <if test="yearGroupName != null and yearGroupName != ''">
                    OR d.name LIKE CONCAT('%', #{yearDataName}, '%')
                </if>
            </if>
        </where>
    </select>

</mapper>
