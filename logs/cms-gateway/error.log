server:
  port: 8081

# Spring
spring:
  redis:
    host: 172.20.0.4
    port: 6379
  cloud:
    gateway:
      discovery:
        locator:
          lowerCaseServiceId: true
          enabled: true
      routes:
          # 路由id，自定义，只要唯一即可
        - id: cms-system
          # 路由的目标地址 lb就是负载均衡，后面跟服务名称
          uri: lb://cms-system
          # 路由断言，也就是判断请求是否符合路由规则的条件
          predicates:
            - Path=/system/**
          # 匹配过滤器
          filters:
            - StripPrefix=1
          # 配置额外信息
          metadata:
            swaggerName: "系统管理服务"
    # 新增的 cms-exam 路由
        - id: cms-xiangmu
          uri: lb://cms-xiangmu
          predicates:
            - Path=/xm/**
          filters:
            - StripPrefix=1
          metadata:
            swaggerName: "一生一项目"

          # 路由id，自定义，只要唯一即可
        - id: cms-file
          # 路由的目标地址 lb就是负载均衡，后面跟服务名称
          uri: lb://cms-file
          # 路由断言，也就是判断请求是否符合路由规则的条件
          predicates:
            - Path=/file/**
          # 匹配过滤器
          filters:
            - StripPrefix=1
          # 配置额外信息
          metadata:
            swaggerName: "系统文件管理服务"
        - id: cms-auth
          uri: lb://cms-auth
          predicates:
            - Path=/auth/**
          filters:
            - CacheRequestFilter
            - StripPrefix=1
security:
  # 不校验白名单
  ignore:
    whites:
      - /auth/logout
      - /auth/login
      - /auth/register
      - /*/v2/api-docs
